{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "halo",
    "lib": ["ES2022"],
    "paths": {
      "halo": ["../runtime/src/index.ts"],
      "halo/*": ["../runtime/src/*"]
    }
  },
  "include": ["**/*.tsx", "../runtime/src"]
}
